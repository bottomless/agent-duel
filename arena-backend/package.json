{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "agent-arena",
  "description": "Headless Agent Arena backend",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --no-env-file --cwd packages/opencode --conditions=browser src/index.ts",
    "start": "bun --no-env-file --cwd packages/opencode --conditions=browser src/index.ts",
    "typecheck": "bun turbo typecheck",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "test": "echo 'Run tests from individual package directories' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/arena-service",
      "packages/codemode",
      "packages/core",
      "packages/effect-drizzle-sqlite",
      "packages/effect-sqlite-node",
      "packages/http-recorder",
      "packages/llm",
      "packages/opencode",
      "packages/plugin",
      "packages/protocol",
      "packages/schema",
      "packages/script",
      "packages/sdk/js",
      "packages/server"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.0-beta.83",
      "@effect/platform-node": "4.0.0-beta.83",
      "@effect/sql-sqlite-bun": "4.0.0-beta.83",
      "@lydell/node-pty": "1.2.0-beta.12",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.3.13",
      "@types/cross-spawn": "6.0.6",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/bun": "1.0.9",
      "@tsconfig/node22": "22.0.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "@octokit/rest": "22.0.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@pierre/diffs": "1.2.10",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "diff": "8.0.2",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.83",
      "remeda": "2.26.0",
      "typescript": "5.8.2",
      "ulid": "3.0.1",
      "zod": "4.1.8"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxlint": "1.60.0",
    "prettier": "3.6.2",
    "turbo": "2.10.2"
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "patchedDependencies": {
    "@ai-sdk/google@3.0.73": "patches/@ai-sdk%2Fgoogle@3.0.73.patch",
    "@ai-sdk/mistral@3.0.51": "patches/@ai-sdk%2Fmistral@3.0.51.patch",
    "@ai-sdk/xai@3.0.102": "patches/@ai-sdk%2Fxai@3.0.102.patch",
    "@ff-labs/fff-bun@0.9.3": "patches/@ff-labs%2Ffff-bun@0.9.3.patch",
    "@modelcontextprotocol/sdk@1.29.0": "patches/@modelcontextprotocol%2Fsdk@1.29.0.patch",
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "effect@4.0.0-beta.83": "patches/effect@4.0.0-beta.83.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch",
    "pacote@21.5.0": "patches/pacote@21.5.0.patch"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
