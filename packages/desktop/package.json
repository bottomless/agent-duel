{
  "name": "@getpaseo/desktop",
  "version": "0.4.0-beta.1",
  "private": true,
  "description": "Agent Duel desktop app (Electron wrapper)",
  "homepage": "https://paseo.sh",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Mohamed Boudra",
    "email": "hello@moboudra.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/getpaseo/paseo.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "npm --prefix ../.. run build:server:clean && npm run build:main && npm run build:arena-runtime && npm run build:deployment-config && electron-builder --config electron-builder.yml",
    "build:arena-runtime": "node scripts/build-arena-runtime.mjs",
    "build:deployment-config": "node scripts/build-deployment-config.mjs",
    "build:main": "tsc -p tsconfig.json && npm run build:notification-permissions",
    "capture-harness": "./capture-harness/run.sh",
    "dev": "./scripts/dev.sh",
    "dev:win": "powershell ./scripts/dev.ps1",
    "test:e2e:renderer": "cross-env E2E_DESKTOP_RUNTIME=1 playwright test --config=playwright.config.ts --project=desktop",
    "test:e2e:browser-tabs": "npm run build:main && node ./e2e/browser-tabs.e2e.mjs",
    "verify:electron-cdp": "node ./scripts/verify-electron-cdp.mjs",
    "test": "vitest run --exclude \"e2e/**\"",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "build:notification-permissions": "node ./scripts/build-notification-permissions.mjs"
  },
  "dependencies": {
    "@getpaseo/cli": "*",
    "@getpaseo/server": "*",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "ws": "^8.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/ws": "^8.5.14",
    "electron": "41.2.0",
    "electron-builder": "26.8.1",
    "node-api-headers": "^1.9.0",
    "typescript": "5.9.3",
    "unzip-crx-3": "^0.2.0",
    "vitest": "^4.1.6",
    "wait-on": "8.0.5"
  }
}
